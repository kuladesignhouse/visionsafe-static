<style>
  .webflow-footer {
    background: #121A2C;
    color: #f1ece4;
    margin-top: 0;
    padding: 92px 30px 34px;
    font-family: "sweet-sans-pro", "Sweet Sans Pro", "Lato", sans-serif;
  }

  .webflow-footer__inner {
    max-width: 1390px;
    margin: 0 auto;
  }

  .webflow-footer__grid {
    display: grid;
    grid-template-columns: minmax(290px, 1.5fr) minmax(160px, 0.8fr) minmax(220px, 0.95fr) minmax(360px, 1.45fr);
    gap: 44px;
    align-items: start;
  }

  .webflow-footer__brand {
    display: inline-flex;
    align-items: center;
  }

  .webflow-footer__brand img {
    width: min(295px, 100%);
    height: auto;
    display: block;
  }

  .webflow-footer__title {
    margin: 4px 0 30px;
    color: #f6f1ea;
    font-size: 23px;
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.005em;
  }

  .webflow-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .webflow-footer__nav a,
  .webflow-footer__legal-link {
    color: rgba(171, 166, 185, 0.78);
    font-size: 15px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .webflow-footer__nav a:hover,
  .webflow-footer__nav a:focus-visible,
  .webflow-footer__legal-link:hover,
  .webflow-footer__legal-link:focus-visible {
    color: #f5f0ea;
  }

  .webflow-footer__signup-copy {
    margin: 0 0 34px;
    max-width: 390px;
    color: rgba(214, 208, 221, 0.9);
    font-size: 18px;
    line-height: 1.55;
  }

  .webflow-footer__signup-form {
    position: relative;
    display: flex;
    align-items: stretch;
    max-width: 430px;
    border-radius: 7px;
    overflow: hidden;
    background: #ffffff;
  }

  .webflow-footer__signup-input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    padding: 20px 22px;
    color: #3b3950;
    font-family: "sweet-sans-pro", "Sweet Sans Pro", "Lato", sans-serif;
    font-size: 18px;
    outline: none;
    background: #ffffff;
    margin-bottom: 0;
    height: 100%;
  }

  .webflow-footer__signup-input::placeholder {
    color: #767282;
  }

  .webflow-footer__signup-button {
    border: 0;
    padding: 0 29px;
    min-height: 64px;
    background: #dfc796;
    color: #5c5060;
    font-family: "sweet-sans-pro", "Sweet Sans Pro", "Lato", sans-serif;
    font-size: 18px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
    z-index: 9;
  }

  .webflow-footer__signup-button:hover,
  .webflow-footer__signup-button:focus-visible {
    background: #ebd5aa;
    color: #46384f;
  }

  .webflow-footer__signup-badge {
    position: absolute;
    top: -12px;
    right: 110px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 3px solid #f0ebf4;
    border-radius: 50%;
    background: #b1235b;
    color: #ffffff;
    pointer-events: none;
  }

  .webflow-footer__signup-badge svg {
    width: 18px;
    height: 18px;
    display: block;
    fill: currentColor;
  }

  .webflow-footer__divider {
    height: 1px;
    margin: 88px 0 42px;
    background: rgba(171, 166, 185, 0.18);
  }

  .webflow-footer__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 24px;
    align-items: center;
  }

  .webflow-footer__copyright {
    margin: 0;
    color: rgba(171, 166, 185, 0.88);
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  .webflow-footer__legal {
    justify-self: center;
  }

  .webflow-footer__social {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 15px;
  }

  .webflow-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: #ffffff;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .webflow-footer__social-link:hover,
  .webflow-footer__social-link:focus-visible {
    color: #dbc095;
    transform: translateY(-1px);
  }

  .webflow-footer__social-link svg {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }

  body > footer > div > div.webflow-footer__grid > div:nth-child(4) > h2.webflow-footer__title {
    margin-bottom: 10px;
  }

  @media (max-width: 1080px) {
    .webflow-footer {
      padding-top: 72px;
    }

    .webflow-footer__grid {
      grid-template-columns: repeat(2, minmax(220px, 1fr));
      gap: 40px 32px;
    }

    .webflow-footer__bottom {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .webflow-footer__legal,
    .webflow-footer__social {
      justify-self: start;
    }

    .webflow-footer__signup-badge {
      right: 112px;
    }
  }

  @media (max-width: 640px) {
    .webflow-footer {
      padding: 60px 20px 32px;
    }

    .webflow-footer__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .webflow-footer__title {
      margin-bottom: 18px;
      font-size: 18px;
    }

    .webflow-footer__nav {
      gap: 14px;
    }

    .webflow-footer__signup-copy {
      margin-bottom: 20px;
      font-size: 16px;
    }

    .webflow-footer__signup-form {
      flex-direction: column;
      max-width: none;
      border-radius: 14px;
      overflow: hidden;
    }

    .webflow-footer__signup-badge {
      display: none;
    }

    .webflow-footer__signup-button {
      width: 100%;
    }

    .webflow-footer__divider {
      margin: 48px 0 28px;
    }

    .webflow-footer__social {
      gap: 16px;
    }
  }
</style>

